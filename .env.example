# 模型网关配置（复制为 .env.local 后填写）
# 这个文件可以提交到仓库，真正的密钥只放在 .env.local

# ---------- 主供应商 ----------
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# ---------- 备用供应商（主供应商失败时降级） ----------
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# ---------- Embedding（RAG 用；DeepSeek 无 embedding 接口） ----------
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# ---------- 数据库（配额 / 幂等要用） ----------
DATABASE_URL=

# ---------- 生成参数 ----------
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=60000
